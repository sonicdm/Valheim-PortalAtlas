<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <AssemblyName>PortalAtlas</AssemblyName>
    <RootNamespace>PortalAtlas</RootNamespace>
    <Version>1.2.6</Version>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
    <FileVersion>1.2.6.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimLibDir Condition="'$(ValheimLibDir)' == ''">E:\Scripts\Valheim Mods\Reqs</ValheimLibDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServerDevcommands is soft + reflection-only; Jötunn is a normal compile dependency. -->
    <Reference Include="$(ValheimLibDir)\*.dll" Exclude="$(ValheimLibDir)\ServerDevcommands.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateValheimLibDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimLibDir)')" Text="Valheim library directory not found: $(ValheimLibDir)" />
  </Target>
</Project>
